-  tmpdir=$Z4H/tmp/ssh.tmp.$sysparams[pid]
+  tmpdir={Z4H_TMP:-$Z4H/tmp}/ssh.tmp.$sysparams[pid]
   zf_rm -rf -- $tmpdir || return
   zf_mkdir -- $tmpdir || return
 fi
@@ -368,9 +368,9 @@ local -i pid=$sysparams[pid]
    return $pipestatus[1]
 } 3>&1 | {
   if (( $+commands[mktemp] )); then
-    tmpdir=$(command mktemp -d -- $Z4H/tmp/ssh.XXXXXXXXXX) || return
+    tmpdir=$(command mktemp -d -- {Z4H_TMP:-$Z4H/tmp}/ssh.XXXXXXXXXX) || return
   else
-    tmpdir=$Z4H/tmp/ssh.tmp.$sysparams[pid]
+    tmpdir={Z4H_TMP:-$Z4H/tmp}/ssh.tmp.$sysparams[pid]
     zf_rm -rf -- $tmpdir || return
     zf_mkdir -- $tmpdir || return
   fi
diff --git a/fn/-z4h-cmd-update b/fn/-z4h-cmd-update
