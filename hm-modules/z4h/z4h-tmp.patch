   zf_rm -f -- $local_hist_tmp || return
 else
@@ -245,9 +245,9 @@ fi
 
 local tmpdir
 if (( $+commands[mktemp] )); then
-  tmpdir=$(command mktemp -d -- $Z4H/tmp/ssh.XXXXXXXXXX) || return
