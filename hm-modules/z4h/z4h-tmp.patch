diff --git a/fn/-z4h-compinit b/fn/-z4h-compinit
index 3abea05..a0853d5 100644
--- a/fn/-z4h-compinit
+++ b/fn/-z4h-compinit
@@ -50,7 +50,7 @@ if [[ -r $dump ]] &&
     (( stat[2] == stat[1] + 1 )); then
   -z4h-compinit-impl -C -d $dump
 else
-  local tmp=$Z4H/tmp/zcompdump.$sysparams[pid]
+  local tmp={Z4H_TMP:-$Z4H/tmp}/zcompdump.$sysparams[pid]
