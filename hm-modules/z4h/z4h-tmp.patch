diff --git a/fn/-z4h-cmd-ssh b/fn/-z4h-cmd-ssh
index b7a0732..025b29c 100644
--- a/fn/-z4h-cmd-ssh
+++ b/fn/-z4h-cmd-ssh
@@ -186,7 +186,7 @@ if (( must_passthrough || !z4h_ssh_enable )); then
 fi
 
 if (( $#z4h_retrieve_history )); then
-  local local_hist_tmp=$Z4H/tmp/ssh-history.tmp.$sysparams[pid]
+  local local_hist_tmp={Z4H_TMP:-$Z4H/tmp}/ssh-history.tmp.$sysparams[pid]
