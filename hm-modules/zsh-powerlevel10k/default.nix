{
  config,
  lib,
  pkgs,
  ...
}:

let
  cfg = config.programs.zsh-powerlevel10k;

  inherit (import ../../utils.nix) listNixFilesAndDirs;

  builtin-themes = import ./builtin-themes.nix;
  builtin-formatters = import ./builtin-git-formatters.nix;

  # format strings ["foo", "bar", "baz"] as:
  # ''
  # - `foo`
  # - `bar`
  # - `baz
  # ''
  mkMDList = vals: lib.join "\n" (map (m: "- `${m}`") vals);
in
with lib;
{
  imports = [
    (lib.modules.mkRenamedOptionModule
      [ "programs" "zsh-powerlevel10k" "extraContent" ]
      [ "programs" "zsh-powerlevel10k" "configContent" ]
    )
    (lib.modules.mkRenamedOptionModule
      [ "programs" "zsh-powerlevel10k" "themeFile" ]
      [ "programs" "zsh-powerlevel10k" "configFile" ]
    )
  ];

  options.programs.zsh-powerlevel10k = {
    enable = mkEnableOption "zsh-powerlevel10k";

    package = mkPackageOption pkgs "zsh-powerlevel10k" { };

    promptInit = mkOption {
      type = types.lines;
      default = ''
        source ${cfg.package}/share/zsh-powerlevel10k/powerlevel10k.zsh-theme
        source "$POWERLEVEL9K_CONFIG_FILE"
      '';
      description = "The command that is ran to inject p10k into the prompt and initialize it";
    };

    configFile = mkOption {
      type = with types; either path str;
      example = literalExpression "config.programs.zsh.dotDir + \"/.p10k.zsh\"";
      description = ''
        Path to the p10k theme file (generally called `.p10k.zsh`).

        If this is a path, then the `theme.*` options will be ignored, and that file will be used instead as the p10k config.
        If this is a string, then the config file will be generated at that path (this is mostly useful for debugging prompts by editing a writable config).
      '';
    };

    configContent = mkOption {
      type = types.lines;
      internal = true;
      description = ''
        The actual content of `configFile`.

        You should only need to modify this if you are making your prompt element.
      '';
    };

    promptElements = mkOption {
      type = types.listOf types.deferredModule;
      description = ''
        A list of submodules describing prompt element options.
      '';
    };

    theme = mkOption {
      type = types.submoduleWith {
        modules = [
          ./p10k-theme-utils.nix
          ./theme-options.nix

          # copy the args (like pkgs, lib, etc.) from the outer evaluation
          { _module.args = lib.mapAttrs (_: lib.mkDefault) config._module.args; }
        ] ++ cfg.promptElements;
      };
      default = { };
      description = literalMD ''
        The set of options defining the prompt theme.
        A few pre-defined themes are available under the `config.programs.zsh-powerlevel10k.themes` attrset:
        ${mkMDList (builtins.attrNames builtin-themes)}
      '';
    };

    themes = mkOption {
      visible = "shallow";
      readOnly = true;
      example = literalExpression ''
        { config, ... }: {
          programs.zsh-powerlevel10k.theme = lib.mkMerge [
            config.programs.zsh-powerlevel10k.themes.robbyrussell
            {
              left-prompt = lib.mkBefore [ "nix-shell" ];
              dir.foreground = lib.mkForce "purple";
            }
          ];
        }
      '';
      default = builtin-themes;
      description = literalMD ''
        A list of pre-defined basic themes, which can be used as a value for `theme`.
        See the example for more info about how to use it.
        *This value is read-only.*
        Available values:
        ${mkMDList (builtins.attrNames builtin-themes)}
      '';
    };

    git-formatters = mkOption {
      visible = "shallow";
      readOnly = true;
      default = builtin-formatters;
      description = literalMD ''
        A list of pre-defined git formatters. *This value is read-only.*
        Available values:
        ${mkMDList (builtins.attrNames builtin-formatters)}
      '';
    };
  };

  config = mkIf cfg.enable {
    home.packages = [ cfg.package ];

    # if configFile is explicitly set to a string, write to it
    home.file = mkIf (lib.isString cfg.configFile) {
      "${lib.removePrefix config.home.homeDirectory cfg.configFile}".text = cfg.configContent;
    };

    # if configFile is not set, make it point to the generated content
    programs.zsh-powerlevel10k.configFile = mkOptionDefault (
      pkgs.writeText ".p10k.zsh" cfg.configContent
    );

    programs.zsh-powerlevel10k = {
      promptElements = listNixFilesAndDirs {
        path = ./elements;
        exceptions = [];
      };

      configContent = lib.mkMerge [
        # this is the very very basic setup code, so this needs to be at the absolute beginning
        (lib.mkOrder 0 ''
          # AUTO-GENERATED!
          # This file was generated by the zsh-powerlevel10k nix module, change its
          # options rather than edit this file. If you just want to fast-iterate on
          # little tweaks, you can just `export POWERLEVEL9K_FOO=bar` and `p10k reload`,
          # and then reproduce those changes in your nix config.

          # Temporarily change options.
          'builtin' 'local' '-a' 'p10k_config_opts'
          [[ ! -o 'aliases'         ]] || p10k_config_opts+=('aliases')
          [[ ! -o 'sh_glob'         ]] || p10k_config_opts+=('sh_glob')
          [[ ! -o 'no_brace_expand' ]] || p10k_config_opts+=('no_brace_expand')
          'builtin' 'setopt' 'no_aliases' 'no_sh_glob' 'brace_expand'
        '')

        # this one has normal order, since it's the "middle" of the file
        ''
          () {
          ${cfg.theme.themeContent}
          }
        ''

        # this is just the cleanup code, so it can be all the way at the end
        (lib.mkOrder 10000 ''
          # Tell `p10k configure` which file it should overwrite.
          typeset -g POWERLEVEL9K_CONFIG_FILE=''${''${(%):-%x}:a}

          (( ''${#p10k_config_opts} )) && setopt ''${p10k_config_opts[@]}
          'builtin' 'unset' 'p10k_config_opts'
        '')
      ];
    };

    programs.zsh.initContent = mkAfter cfg.promptInit;

    programs.zsh.envExtra = mkAfter ''
      export POWERLEVEL9K_DISABLE_CONFIGURATION_WIZARD=true
      export POWERLEVEL9K_CONFIG_FILE="${cfg.configFile}"
    '';
  };

  meta.maintainers = with lib.maintainers; [ blokyk ];
}
